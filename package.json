    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "input-otp": "^1.5.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "vinext": "^1.0.0-beta.8"
