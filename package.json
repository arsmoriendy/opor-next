{
  "name": "opor-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "dev:vinext": "vinext dev --port 3001",
